#!/bin/bash
# Live embedding API credentials for manual knowledge-base smoke testing.
#
# Copy this file to `.env` in the same directory and fill in real values:
#   cp test/knowledge/live/.env.example test/knowledge/live/.env
# The real `.env` is already git-ignored (see .gitignore "Environments"),
# so your keys never get committed. This `.env.example` is a tracked template.
#
# Omit a provider's block to skip it during the run.

# --- OpenAIEmbeddingClient (OpenAI Embedding compatible) ---
OPENAI_EMBEDDING_BASE_URL="https://api.openai.com/v1"
OPENAI_EMBEDDING_API_KEY="sk-XXXXXX"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_EMBEDDING_DIMENSIONS=""

# --- DashScope (Alibaba Cloud, text-embedding-v4) ---
DASHSCOPE_EMBEDDING_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
DASHSCOPE_EMBEDDING_API_KEY="sk-XXXXXX"
DASHSCOPE_EMBEDDING_MODEL="text-embedding-v4"
DASHSCOPE_EMBEDDING_DIMENSIONS=""

# --- AIMLAPI (Qwen v4 via proxy) ---
AIMLAPI_EMBEDDING_BASE_URL="https://api.aimlapi.com/v1"
AIMLAPI_EMBEDDING_API_KEY="XXXXXX"
AIMLAPI_EMBEDDING_MODEL="alibaba/qwen-text-embedding-v4"
AIMLAPI_EMBEDDING_DIMENSIONS=""
